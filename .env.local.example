# ─────────────────────────────────────────────────────────────────────────────
# StellarNotify Frontend — Environment Variables
# Copy this file to .env.local and fill in the values for your environment.
# NEVER commit .env.local — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stellar / Soroban RPC ─────────────────────────────────────────────────────

# Soroban RPC endpoint.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase — must match the RPC endpoint above.
# Testnet:  Test SDF Network ; September 2015
# Mainnet:  Public Global Stellar Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed StellarNotify Soroban contract address (C…, 56 chars).
NEXT_PUBLIC_NOTIFY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── StellarNotify Backend API ─────────────────────────────────────────────────

# Base URL of the StellarNotify backend (Node.js/TypeScript service).
# Local dev:  http://localhost:3001
# Hosted:     https://api.stellarnotify.xyz
NEXT_PUBLIC_API_URL=http://localhost:3001
